{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib":              ["dom", "dom.iterable", "ES2022"],
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "preserve",
    "incremental":      true,
    "paths":            { "@/*": ["./src/*"] },
    "plugins":          [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}